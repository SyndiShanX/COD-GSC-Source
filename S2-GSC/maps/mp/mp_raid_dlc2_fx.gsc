sunflare_mapstart() {
  wait(5);
  level thread common_scripts\_exploder::func_88E(9);
}

sunflare_flying() {
  stopclientexploder(9, level.players, 1);
  wait 0.05;
  start_sunflare_flying_exploder();
}

start_sunflare_flying_exploder() {
  level thread common_scripts\_exploder::func_88E(1);
}

start_sunflare_flying_exploder_for_player(param_00) {
  level thread common_scripts\_exploder::func_88E(1, param_00);
}