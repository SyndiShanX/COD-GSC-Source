play_house_explo(var_0) {
  var_1[0] = (-71, -1031, 74);
  var_1[1] = (475, -1250, 74);
  var_1[2] = (-25, -1124, 74);
  var_1[3] = (440, -720, 74);
  var_1[4] = (-1138, -4118, 62);
  var_1[5] = (845, -3109, 38);
  var_1[6] = (-4549, -2603, 117);
  var_1[7] = (-3780, -3981, 114);
  var_1[8] = (-320, -1135, 104);
  var_1[9] = (-1036, -1021, 38);
  var_2[0] = (-963, -3057, 67);
  var_2[1] = (-799, -2501, 67);
  var_2[2] = (-1196, -2113, 67);
  var_2[3] = (-2025, -2284, 67);
  var_2[4] = (-2137, -3174, 67);
  var_3 = scripts\engine\utility::random(var_1);
  thread scripts\engine\utility::play_sound_in_space("emt_street_dist_explosion_long", var_3);
  earthquake(0.1, 0.3, level.player.origin, 100);
  level.player playRumbleOnEntity("damage_light");
  scripts\engine\utility::exploder("house_falling_dust");
  wait(1.0 + randomfloat(8));
  var_4 = scripts\engine\utility::random(var_2);
  thread scripts\engine\utility::play_sound_in_space("scn_hometown_russian_gunfire_dist_quick_burst", var_4);
  wait(1.0 + randomfloat(8));
  var_5 = scripts\engine\utility::random(var_2);
  thread scripts\engine\utility::play_sound_in_space("scn_hometown_russian_gunfire_dist_single_shot", var_5);
}

carried_remove_fov_user_scale_override(var_0) {
  level.player lerpfovscalefactor(1, 3);
}

sfx_hometown_door_open_filtering_change(var_0) {
  level.player clearsoundsubmix("sp_ht_truck_by_door");
  wait 2.5;
  level.player setsoundsubmix("sp_ht_truck_by_door");
  level waittill("truck_passby_done");
  level.player clearsoundsubmix("sp_ht_truck_by_door");
}

